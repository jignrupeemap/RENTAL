# Fallback for when the WHOLE project is uploaded into public_html
# (recommended layout is public/ → public_html and the rest one level up;
# see docs/DEPLOYMENT.md). This sends every request into public/ so that
# app/, config/, storage/, database/ are never reachable from the web.
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|bin|config|database|docs|routes|storage|tests|views)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
